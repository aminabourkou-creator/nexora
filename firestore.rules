rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── USERS COLLECTION ──
    match /users/{userId} {
      // Each user can only read/write their own document
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
      
      // User's friends subcollection
      match /friends/{friendId} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's blocked users subcollection
      match /blocked/{blockedUserId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // ── ROOMS COLLECTION ──
    match /rooms/{roomId} {
      // Allow read if user is a member
      allow read: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
      
      // Only owner can update room metadata
      allow write: if request.auth.uid == resource.data.owner;
      
      // Only owner can delete
      allow delete: if request.auth.uid == resource.data.owner;
      
      // Allow create if authenticated
      allow create: if request.auth.uid != null && request.auth.uid == request.resource.data.owner;
      
      // Room members subcollection
      match /members/{userId} {
        allow read: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow write: if request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.owner;
      }
      
      // Room messages
      match /messages/{messageId} {
        allow read: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow create: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)) 
                     && request.auth.uid == request.resource.data.sender;
        allow update: if request.auth.uid == resource.data.sender;
        allow delete: if request.auth.uid == resource.data.sender 
                     || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.owner;
      }
      
      // Room tasks
      match /tasks/{taskId} {
        allow read: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow create: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow update: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow delete: if request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.owner;
      }
      
      // Room files
      match /files/{fileId} {
        allow read: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow create: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)) 
                     && request.auth.uid == request.resource.data.uploadedBy;
        allow delete: if request.auth.uid == resource.data.uploadedBy 
                     || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.owner;
      }
      
      // Voice signals for WebRTC
      match /voiceSignals/{signalId} {
        allow read, write: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        match /candidatesA/{docId} {
          allow read, write: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        }
        match /candidatesB/{docId} {
          allow read, write: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        }
      }
      
      // Voice presence
      match /voice/{userId} {
        allow read: if exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow write: if request.auth.uid == userId;
      }
    }
    
    // ── DIRECT MESSAGES COLLECTION ──
    match /directMessages/{conversationId} {
      // Allow read if user is one of the participants
      allow read: if request.auth.uid in resource.data.participants;
      
      // Messages in conversation
      match /messages/{messageId} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants;
        allow create: if request.auth.uid in get(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants
                     && request.auth.uid == request.resource.data.sender;
        allow update: if request.auth.uid == resource.data.sender;
        allow delete: if request.auth.uid == resource.data.sender;
      }
    }
    
    // ── NOTIFICATIONS COLLECTION ──
    match /notifications/{userId} {
      allow read, write: if request.auth.uid == userId;
      
      match /items/{notificationId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // ── FRIEND REQUESTS COLLECTION ──
    match /friendRequests/{requestId} {
      allow read: if request.auth.uid in resource.data.participants;
      allow create: if request.auth.uid == request.resource.data.from && request.auth.uid != null;
      allow update: if request.auth.uid == resource.data.to;
      allow delete: if request.auth.uid == resource.data.from || request.auth.uid == resource.data.to;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
